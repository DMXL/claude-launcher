{
  "name": "@dmxl/claude-launcher",
  "version": "0.1.0",
  "description": "Run Claude Code against any model.",
  "license": "MIT",
  "author": "DMXL <dm@dmon-studio.com>",
  "homepage": "https://github.com/DMXL/claude-launcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DMXL/claude-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/DMXL/claude-launcher/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "deepseek",
    "mimo",
    "llm",
    "cli"
  ],
  "type": "module",
  "bin": {
    "claude-launcher": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "node src/index.ts",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  }
}
