{
  "name": "claude-launcher",
  "version": "0.0.0",
  "description": "Run Claude Code against any model.",
  "private": true,
  "type": "module",
  "bin": {
    "claude-launcher": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "node src/index.ts",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  }
}
